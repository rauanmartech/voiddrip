# Supabase
# Obtenha em: https://supabase.com/dashboard/project/<project-id>/settings/api
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# MercadoPago
# Obtenha em: https://www.mercadopago.com.br/developers/pt/docs/getting-started
VITE_MERCADO_PAGO_PUBLIC_KEY=<your-mercadopago-public-key>
MERCADO_PAGO_ACCESS_TOKEN=<your-mercadopago-access-token>
MERCADO_PAGO_WEBHOOK_SECRET=<your-mercadopago-webhook-secret>
